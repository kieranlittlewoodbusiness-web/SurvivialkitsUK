---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  canonical?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** @deprecated S1-7: the Amazon disclosure is a single site-wide footer line. Ignored. */
  showAmazonNotice?: boolean;
}

const {
  title,
  description = site.description,
  canonicalPath,
  canonical,
  noindex = false,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      canonical={canonical}
      noindex={noindex}
      ogType={ogType}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
