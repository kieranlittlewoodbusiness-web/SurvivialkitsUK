---
/**
 * Visible breadcrumb trail. JSON-LD BreadcrumbList is built separately in src/lib/seo/jsonld.ts
 * and must use the same labels and hrefs.
 *
 * Separator defaults to "/" (the existing compare-page style). The SEO-9 bio brief uses "›".
 */
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /**
   * Glyph between items, drawn by CSS ::before with empty alt text so screen readers skip it
   * (CR N3 on #38). Only these two glyphs: each has a literal CSS rule (see the style block).
   */
  separator?: '/' | '›';
  /** Spacing on the list: compare uses start, the bio page uses end. */
  pad?: 'start' | 'end';
}

const { items, separator = '/', pad = 'start' } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class:list={['crumbs', pad === 'end' && 'crumbs--end', separator === '›' && 'crumbs--chevron']}>
    {
      items.map((item, i) => {
        const current = i === items.length - 1;
        return (
          <li aria-current={current ? 'page' : undefined}>
            {!current && item.href ? <a href={item.href}>{item.label}</a> : item.label}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    list-style: none;
    padding: var(--s-3) 0 0;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .crumbs--end {
    padding: 0 0 var(--s-4);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    min-width: var(--tap);
    color: var(--ink-2);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
  }
  /*
   * CR N3 (#38): the separator is decoration, so it gets empty alt text ("/ \"\"") and screen
   * readers skip it. Each rule repeats the plain content first as a fallback: Safari before 17.4
   * does not know the alt syntax and drops that declaration at parse time, keeping the first.
   * The glyphs are literals on purpose. With var(--crumb-sep) the alt declaration would always
   * parse (var() defers validation), then fail at computed-value time in those browsers, leaving
   * no separator at all instead of falling back.
   */
  .crumbs li + li::before {
    content: "/";
    content: "/" / "";
    margin-right: var(--s-2);
    color: var(--ink-3);
  }
  .crumbs--chevron li + li::before {
    content: "›";
    content: "›" / "";
  }
</style>
