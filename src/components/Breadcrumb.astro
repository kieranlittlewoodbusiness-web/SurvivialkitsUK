---
/**
 * Visible breadcrumb trail. JSON-LD BreadcrumbList is built separately in src/lib/seo/jsonld.ts
 * and must use the same labels and hrefs.
 *
 * Separator defaults to "/" (the existing compare-page style). The SEO-9 bio brief uses "›".
 */
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  /** Glyph between items (CSS ::before, not in the accessibility tree as a link). */
  separator?: string;
  /** Spacing on the list: compare uses start, the bio page uses end. */
  pad?: 'start' | 'end';
}

const { items, separator = '/', pad = 'start' } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class:list={['crumbs', pad === 'end' && 'crumbs--end']} style={`--crumb-sep: ${JSON.stringify(separator)}`}>
    {
      items.map((item, i) => {
        const current = i === items.length - 1;
        return (
          <li aria-current={current ? 'page' : undefined}>
            {!current && item.href ? <a href={item.href}>{item.label}</a> : item.label}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    list-style: none;
    padding: var(--s-3) 0 0;
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .crumbs--end {
    padding: 0 0 var(--s-4);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    min-width: var(--tap);
    color: var(--ink-2);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
  }
  .crumbs li + li::before {
    content: var(--crumb-sep);
    margin-right: var(--s-2);
    color: var(--ink-3);
  }
</style>
