---
/**
 * UK Survival Kits wordmark (S1-11). Uses Kieran's supplied outlined SVGs, which read
 * "UK Survival Kits.uk" and need no font. tone="default" follows the colour scheme
 * (logo-on-light on Limestone, logo-on-dark in dark mode); tone="band" always sits on Forest.
 */
import { site } from '../data/site';

interface Props {
  tone?: 'default' | 'band';
  href?: string | null;
}
const { tone = 'default', href = '/' } = Astro.props;
const Tag = href ? 'a' : 'span';
const alt = href ? `${site.name}, home` : site.name;
---

<Tag class:list={['wordmark', `wordmark--${tone}`]} href={href ?? undefined}>
  {
    tone === 'band' ? (
      <img class="wordmark__img" src="/brand/logo-on-dark.svg" width="426" height="64" alt={alt} decoding="async" />
    ) : (
      <picture>
        <source srcset="/brand/logo-on-dark.svg" media="(prefers-color-scheme: dark)" width="426" height="64" />
        <img class="wordmark__img" src="/brand/logo-on-light.svg" width="426" height="64" alt={alt} decoding="async" />
      </picture>
    )
  }
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
    flex: none;
  }
  .wordmark picture {
    display: block;
  }
  /* Keep a quarter of the tile width clear around the mark (brand guide): the header gap handles it. */
  .wordmark__img {
    display: block;
    width: auto;
    height: 34px;
    max-width: none;
  }
  @media (max-width: 399px) {
    .wordmark__img {
      height: 27px;
    }
  }
</style>
