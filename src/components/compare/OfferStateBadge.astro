---
import { OFFER_LABEL_TEXT, type OfferLabel } from './offerModel';

interface Props {
  label: OfferLabel | 'verified';
}

const { label } = Astro.props;
const text = label === 'verified' ? 'Verified' : OFFER_LABEL_TEXT[label];
const tone = label === 'verified' ? 'ok' : label === 'stale' ? 'stale' : 'warn';
---

<span class:list={['offer-state', `offer-state--${tone}`]}>{text}</span>

<style>
  .offer-state {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
    padding: 0.15rem 0.45rem;
    border: 1px solid currentColor;
  }

  .offer-state--ok {
    color: var(--signal-deep);
    background: rgba(15, 92, 76, 0.08);
  }

  .offer-state--warn {
    color: var(--warn);
    background: #f7f0e4;
  }

  .offer-state--stale {
    color: #8f2424;
    background: #fbecec;
  }
</style>
