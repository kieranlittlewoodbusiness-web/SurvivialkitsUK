---
/**
 * Be Ready checklist matrix. Below 48rem each checklist item stacks as a small card with every
 * kit's value labelled (no sideways swipe, issue #3 S1-3 finding 4); from 48rem it is a normal
 * table. Explicit ARIA table roles keep the table semantics when the stacked layout changes
 * `display` (Safari drops them otherwise).
 */
import { matrixKits, matrixRows } from './kits';
---

<div class="matrix">
  <table role="table" aria-labelledby="matrix-caption">
    <caption id="matrix-caption">
      What each kit lists against the Be Ready checklist (from seller listings, not tested)
    </caption>
    <thead>
      <tr role="row">
        <th scope="col" role="columnheader">Checklist item</th>
        {
          matrixKits.map((k) => (
            <th scope="col" role="columnheader">
              {k.label}
              <span>{k.people}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        matrixRows.map((row) => (
          <tr class:list={[row.emphasis && 'is-emphasis']} role="row">
            <th scope="row" role="rowheader">{row.item}</th>
            {row.values.map((v, i) => (
              <td role="cell" class:list={[/^Not listed|^Excluded/.test(v) && 'is-gap']}>
                <span class="matrix__kit" aria-hidden="true">{matrixKits[i]?.label}</span>
                {v}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .matrix {
    border: 1px solid var(--line);
    background: #fff;
    max-width: 100%;
  }

  table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    font-size: 0.92rem;
  }

  caption {
    text-align: left;
    padding: 0.75rem;
    font-weight: 600;
  }

  th,
  td {
    padding: 0.55rem 0.65rem;
    border-top: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    background: var(--field);
    font-size: 0.88rem;
  }

  thead th span {
    display: block;
    font-weight: 400;
    color: var(--ink-muted);
  }

  tbody th {
    background: var(--field);
  }

  .is-gap {
    color: #8f2424;
  }

  .is-emphasis td,
  .is-emphasis th {
    font-weight: 700;
  }

  .matrix__kit {
    display: none;
  }

  /* Stacked: one card per checklist item, each value labelled with its kit. */
  @media (max-width: 47.99rem) {
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    caption {
      display: block;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    tbody tr {
      border-top: 1px solid var(--line);
    }

    tbody th {
      border-top: 0;
    }

    td {
      display: grid;
      grid-template-columns: minmax(6.5rem, 38%) 1fr;
      gap: 0.5rem;
      border-top: 1px dashed var(--line);
    }

    .matrix__kit {
      display: block;
      font-weight: 600;
      color: var(--ink-muted);
    }

    .is-gap .matrix__kit {
      color: var(--ink-muted);
    }
  }
</style>
