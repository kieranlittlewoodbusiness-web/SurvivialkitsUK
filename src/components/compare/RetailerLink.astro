---
/**
 * Outbound retailer action for one DisplayOffer. Affiliate-only (Kieran's ruling on #3):
 * - affiliate link (contract: is_affiliate_link with a programme URL): Ad label + AffiliateLink
 *   (rel="sponsored nofollow noopener noreferrer"), visible text names the model, e.g.
 *   "Check E184 at EVAQ8", so repeated buttons read differently on screen.
 * - anything else: plain text "Retailer link coming soon". No link, no disabled-looking button.
 */
import AffiliateLink from '../AffiliateLink.astro';
import { affiliateHref } from './cardModel';
import type { DisplayOffer } from './offerModel';

interface Props {
  offer: DisplayOffer;
  modelCode: string;
  variant?: 'button' | 'text';
}

const { offer, modelCode, variant = 'button' } = Astro.props;
const href = affiliateHref(offer);
const cls = variant === 'button' ? 'btn retailer-link' : 'retailer-link retailer-link--text';
---

{
  href ? (
    <span class="retailer-link-wrap">
      <span class="badge badge--ad">Ad</span>
      <AffiliateLink href={href} merchant={offer.retailer} class={cls}>
        Check {modelCode} at {offer.retailer}<span class="visually-hidden"> (affiliate link)</span>
      </AffiliateLink>
    </span>
  ) : (
    <p class="retailer-soon">Retailer link coming soon</p>
  )
}

<style>
  .retailer-link-wrap {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .retailer-link--text {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .retailer-soon {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
</style>
