---
/** Page-level offer data state: empty, error, or example-fixture banner. */
import type { OffersResult } from './offerModel';

interface Props {
  result: OffersResult;
}

const { result } = Astro.props;
---

{
  result.fixture && result.status !== 'error' && (
    <div class="offers-notice offers-notice--fixture" role="note">
      <strong>Example data, not real prices.</strong> This build uses test fixtures to show every
      price state. Do not publish.
    </div>
  )
}
{
  result.status === 'empty' && (
    <div class="offers-notice" role="status">
      <strong>No verified prices yet.</strong> We only show a price once we have checked it, with the
      retailer, date and UK time. Until then, use the links on each kit to check the seller’s current
      price and delivery.
    </div>
  )
}
{
  result.status === 'error' && (
    <div class="offers-notice offers-notice--error" role="alert">
      <strong>Prices could not be loaded for this version of the page.</strong> The kit details below
      are unaffected. Check prices directly with each seller using the links on each kit.
    </div>
  )
}

<style>
  .offers-notice {
    margin: 1.25rem 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--ink-muted);
    background: var(--field);
    max-width: 42rem;
    font-size: 0.95rem;
  }

  .offers-notice--error {
    border-left-color: #8f2424;
    background: #fbecec;
  }

  .offers-notice--fixture {
    border: 2px dashed var(--warn);
    background: #f7f0e4;
  }
</style>
