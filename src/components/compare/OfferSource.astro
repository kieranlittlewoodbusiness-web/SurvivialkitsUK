---
/**
 * "Price source:" attribution for one offer (PR #9 L1), as text only: no outbound link, because
 * the source is a retailer page and S1-2b allows affiliate links only (issue #3).
 */
import { displayHost } from './cardModel';
import type { DisplayOffer } from './offerModel';

interface Props {
  offer: DisplayOffer;
}

const { offer } = Astro.props;
---

<p class="offer-source">Price source: {offer.source.name} ({displayHost(offer.source.url)})</p>

<style>
  .offer-source {
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-muted);
  }
</style>
