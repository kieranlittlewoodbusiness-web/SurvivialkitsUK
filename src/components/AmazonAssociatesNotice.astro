---
import { site } from '../data/site';
import { hasLiveAmazonOffers } from '../lib/retailerOffers';

/**
 * Prominent Amazon Associates statement — only when Amazon links are live
 * (site flag and at least one enabled Amazon offer URL).
 */
const show = site.amazonAssociatesLive && hasLiveAmazonOffers();
---

{
  show && (
    <aside class="amazon-notice" role="note" aria-label="Amazon Associates disclosure">
      <strong>Amazon Associates disclosure</strong>
      As an Amazon Associate we earn from qualifying purchases. Amazon and the Amazon logo are
      trademarks of Amazon.com, Inc. or its affiliates.
    </aside>
  )
}
