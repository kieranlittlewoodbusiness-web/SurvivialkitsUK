---
interface Props {
  flags: string[];
}

const { flags } = Astro.props;
---

{
  flags.length > 0 && (
    <aside class="review-flags" role="note" aria-label="Editorial review flags">
      <strong>Flagged for editorial review before publication</strong>
      <ul>
        {flags.map((flag) => (
          <li>{flag}</li>
        ))}
      </ul>
      <p>
        These items are unsupported safety claims or unverified specifications. Do not treat them as
        published fact until cleared.
      </p>
    </aside>
  )
}

<style>
  .review-flags {
    margin: 1.25rem 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--warn);
    border-left-width: 4px;
    background: #f7f0e4;
    max-width: 40rem;
  }

  .review-flags strong {
    display: block;
    color: var(--warn);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .review-flags ul {
    margin: 0 0 0.65rem;
    padding-left: 1.15rem;
  }

  .review-flags p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-muted);
    max-width: none;
  }
</style>
