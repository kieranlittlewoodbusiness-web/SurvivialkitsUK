---
import type { ComparedProduct } from '../lib/productComparisons';
import { resolveProductOffers } from '../lib/productComparisons';
import EvidenceBadge from './EvidenceBadge.astro';
import AffiliateLink from './AffiliateLink.astro';

interface Props {
  product: ComparedProduct;
  /** When true, omit retailer links (e.g. print contexts). */
  hideBuys?: boolean;
}

const { product, hideBuys = false } = Astro.props;
// S1-7: legacy retailer offers never render. Outbound product links come only from the
// Amazon catalogue (src/components/catalogue), so this card shows criteria without links.
const offers: ReturnType<typeof resolveProductOffers> = hideBuys ? [] : [];
const liveOffers = offers.filter((o) => o.enabled && o.url.trim());
const evidenceLabel =
  product.evidence === 'firsthand-test' ? 'Personally tested' : 'Researched';
---

<article class="product-card" data-product-id={product.id}>
  <header class="product-card__head">
    <h3>{product.name}</h3>
    <div class="product-card__badges">
      <EvidenceBadge kind={product.evidence} />
      <span class="badge">{evidenceLabel}</span>
    </div>
  </header>

  <p><strong>Who it suits:</strong> {product.suits}</p>

  <h4>Key specifications</h4>
  <ul>
    {product.specs.map((s) => <li>{s}</li>)}
  </ul>

  <h4>Limitations</h4>
  <ul>
    {product.limitations.map((s) => <li>{s}</li>)}
  </ul>

  {
    product.reviewFlags.length > 0 && (
      <div class="review-flag" role="note">
        <strong>Editorial review before publication</strong>
        <ul>
          {product.reviewFlags.map((flag) => (
            <li>{flag}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    !hideBuys && (
      <div class="product-card__buy no-print">
        <p class="ad-inline-label">
          <span class="badge badge--ad">Ad</span>
          Retailer choices (after the guidance above)
        </p>
        {liveOffers.length > 0 ? (
          <ul class="buy-list">
            {liveOffers.map((offer) => (
              <li>
                <AffiliateLink href={offer.url} merchant={offer.merchant}>
                  {offer.title}
                </AffiliateLink>
                <span class="buy-meta">
                  {offer.merchant}
                  {offer.priceBand ? ` · ${offer.priceBand}` : ''}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="buy-pending">
            Buying links for this item are not live yet. Programme URLs will appear here after
            approval—criteria above stand on their own.
          </p>
        )}
      </div>
    )
  }
</article>

<style>
  .product-card {
    background: var(--field);
    border: 1px solid var(--line);
    border-left: 4px solid var(--signal);
    padding: 1.1rem 1.15rem 1.25rem;
    min-width: 0;
  }

  .product-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .product-card__head h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .product-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .product-card h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    margin: 0.85rem 0 0.35rem;
    letter-spacing: 0;
  }

  .product-card ul {
    margin: 0 0 0.5rem;
    padding-left: 1.15rem;
  }

  .product-card li {
    margin-bottom: 0.3rem;
  }

  .product-card p {
    max-width: none;
  }

  .review-flag {
    margin-top: 0.85rem;
    padding: 0.75rem 0.85rem;
    border: 1px dashed var(--warn);
    background: var(--warning-soft);
    font-size: 0.92rem;
  }

  .review-flag strong {
    display: block;
    color: var(--warn);
    margin-bottom: 0.35rem;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product-card__buy {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .ad-inline-label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.92rem;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .buy-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .buy-list li + li {
    margin-top: 0.55rem;
  }

  .buy-meta {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .buy-pending {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-muted);
  }
</style>
