---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { AMAZON_DISCLOSURE } from './catalogue/catalogueView';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Wordmark tone="band" />
        <p class="site-footer__tagline">Ready for the unexpected.</p>
        <p>Independent UK household readiness guides. Start with what you already own; fill gaps gradually.</p>
        <p>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/editorial-policy/">Editorial policy</a> ·
          <a href="/privacy/">Privacy</a>
        </p>
      </div>
      <div>
        <h2 class="footer-heading">Useful numbers</h2>
        <ul class="footer-list">
          <li>Emergency services: <strong>999</strong></li>
          <li>NHS / NHS 24: <strong>111</strong></li>
          <li>Power cut (England, Scotland, Wales): <strong>105</strong></li>
          <li>Floodline: <strong>0345 988 1188</strong></li>
          <li>Priority Services Register: <a href="https://www.thepsr.co.uk/" rel="noopener noreferrer">thepsr.co.uk</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-heading">Official guidance</h2>
        <ul class="footer-list">
          <li><a href="https://beready.campaign.gov.uk/be-ready-for-emergencies/" rel="noopener noreferrer">Be Ready (UK)</a></li>
          <li><a href="https://ready.campaign.gov.scot/" rel="noopener noreferrer">Ready Scotland</a></li>
          <li><a href="/sources/">All sources we cite</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__legal">
      <p class="amazon-disclosure" data-testid="amazon-disclosure">{AMAZON_DISCLOSURE}</p>
      <p>© {new Date().getFullYear()} {site.name}. No third-party tracking scripts on this launch build.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-8);
    padding: var(--s-7) 0 calc(var(--s-6) + env(safe-area-inset-bottom, 0));
    background: var(--band);
    color: var(--on-band-2);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  .site-footer a { color: var(--on-band); }
  .site-footer a:hover { color: var(--band-accent); }
  .site-footer :focus-visible { outline-color: var(--focus-on-band); }
  .site-footer__tagline { margin-top: var(--s-3); color: var(--band-accent); font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); line-height: 1.1; }
  .site-footer strong { color: var(--on-band); }
  .site-footer p { max-width: 34rem; }
  .site-footer__grid { display: grid; gap: var(--s-6); }
  .footer-heading { color: var(--on-band); font-size: var(--step-0); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: var(--s-3); }
  .footer-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .footer-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.35em; min-height: var(--tap); }
  .footer-list a { display: inline-flex; align-items: center; min-height: var(--tap); }
  .site-footer__legal { margin-top: var(--s-6); padding-top: var(--s-5); border-top: 1px solid rgb(244 239 229 / 0.16); font-size: var(--step--1); }
  .site-footer__legal p { margin: 0 0 var(--s-2); }
  .amazon-disclosure { color: var(--on-band); }
  @media (min-width: 768px) { .site-footer__grid { grid-template-columns: 1.4fr 1fr 1fr; } }
</style>
