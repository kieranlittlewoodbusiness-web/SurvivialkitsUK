---
import type { RetailerOffer } from '../lib/retailerOffers';
import AffiliateLink from './AffiliateLink.astro';

interface Props {
  /** Show Ad label before any commercial content. */
  offers?: RetailerOffer[];
  heading?: string;
  pendingNote?: string;
}

const {
  offers = [],
  heading = 'Where to buy (examples)',
  pendingNote = 'Affiliate links for this category are not live yet. We will only publish programme-generated URLs after retailer approval.',
} = Astro.props;

const live = offers.filter((o) => o.enabled && o.url.trim());
---

<aside class="ad-block" aria-label="Advertisement">
  <div class="ad-block__label">Ad</div>
  <h3>{heading}</h3>
  <p class="ad-block__note">
    This section is advertising. If you follow a link and buy something, we may earn a commission.
    Editorial criteria above are separate from these retailer examples.
  </p>

  {
    live.length > 0 ? (
      <ul class="ad-list">
        {live.map((offer) => (
          <li>
            <AffiliateLink href={offer.url} merchant={offer.merchant}>
              {offer.title}
            </AffiliateLink>
            <span class="ad-meta">
              {offer.merchant}
              {offer.priceBand ? ` · ${offer.priceBand}` : ''}
            </span>
            <p>{offer.summary}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="ad-pending">{pendingNote}</p>
    )
  }
</aside>

<style>
  .ad-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ad-list li + li {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .ad-meta {
    display: block;
    font-size: 0.88rem;
    color: var(--ink-muted);
    margin: 0.2rem 0 0.35rem;
  }

  .ad-pending {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
</style>
