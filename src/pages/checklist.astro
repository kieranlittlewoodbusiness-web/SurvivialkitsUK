---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';

const inventory = [
  'Working torch (not only phone light) + spare batteries or wind-up',
  'Warm blankets / sleeping bags / spare layers',
  'Battery or wind-up FM radio (or a noted car-radio plan if safe)',
  'Charged power bank + leads',
  'Bottled water or clean sealed containers you can fill',
  'Ready-to-eat food you already buy + tin opener',
  'Essential medication for several days + written doses',
  'Basic first-aid items',
  'Hand sanitiser / wet wipes',
  'Cash (coins and notes) as well as cards',
  'Paper list of phone numbers (105, household, insurance, radio freqs)',
  'ID / insurance / prescription copies or known locations',
  'Baby supplies / ready-to-feed formula if needed',
  'Pet food and water if needed',
  'Spare glasses, hearing-aid batteries or mobility aids if needed',
];

const plan = [
  'Escape routes (fire) and flood actions if relevant',
  'Household meeting point if you cannot return home',
  'ICE / Medical ID on phones; tell the nominated contact',
  'School or childcare numbers checked',
  'Priority Services Register / Customer Care Register checked if eligible',
  'Flood warnings signed up (Environment Agency or SEPA Floodline)',
  'Met Office weather warnings method chosen',
];

const gaps = [
  'Drinking water: about 3 litres per person per day for three days (more for hygiene, cooking, pets, formula)',
  'Three days of non-perishable food that needs no cooking or fridge',
  'Waterproof grab-bag subset if flood leave is plausible',
];
---

<BaseLayout
  title="72-hour checklist"
  description="Inventory-first 72-hour household readiness checklist for UK homes, aligned with official guidance."
  canonicalPath="/checklist"
>
  <section class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Checklist</p>
      <h1>72-hour household checklist</h1>
      <p class="lede">
        Start with what you already own. UK guidance frames a few days of readiness so help can
        reach people who need it most.
      </p>
      <p>
        <EvidenceBadge kind="official-guidance" />
        Based on Prepare, Ready Scotland and the National Resilience / Be Ready checklist. Re-verify
        quantities on those pages when you review.
      </p>
      <div class="btn-row">
        <button class="btn btn--ghost" type="button" onclick="window.print()">Print checklist</button>
      </div>
    </div>
  </section>

  <section class="section checklist">
    <div class="wrap wrap--narrow reveal">
      <details open>
        <summary>Step A — Inventory (buy nothing yet)</summary>
        {
          inventory.map((item) => (
            <label>
              <input type="checkbox" name="inventory" />
              <span>{item}</span>
            </label>
          ))
        }
      </details>

      <details open>
        <summary>Step B — Plan on paper</summary>
        {
          plan.map((item) => (
            <label>
              <input type="checkbox" name="plan" />
              <span>{item}</span>
            </label>
          ))
        }
      </details>

      <details open>
        <summary>Step C — Fill gaps gradually</summary>
        <p>
          Only after A and B: add missing items on normal shops. Prefer food and water you already
          use.
        </p>
        {
          gaps.map((item) => (
            <label>
              <input type="checkbox" name="gaps" />
              <span>{item}</span>
            </label>
          ))
        }
      </details>

      <details open>
        <summary>Step D — Review</summary>
        <label>
          <input type="checkbox" name="review" />
          <span>Calendar reminder in six months</span>
        </label>
        <label>
          <input type="checkbox" name="review" />
          <span>Neighbour contact swap if appropriate</span>
        </label>
      </details>

      <p class="next-links">
        Next: <a href="/scenarios">scenario guides</a> · <a href="/gear">gear criteria</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .next-links {
    margin-top: 2rem;
    color: var(--ink-muted);
  }
</style>
