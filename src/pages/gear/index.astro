---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedGear } from '../../lib/content';

const gear = await getPublishedGear();
---

<BaseLayout
  title="Gear criteria"
  description="Comparison criteria for torches, power banks, radios, water storage, first-aid kits and winter travel supplies."
  canonicalPath="/gear"
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Gear</p>
      <h1>Comparison criteria</h1>
      <p class="lede">
        Criteria first. Retailer examples appear only in clearly labelled Ad sections after you have
        read what matters.
      </p>
      <ul class="link-list">
        {
          gear.map((entry) => (
            <li>
              <a href={`/gear/${entry.id}`}>
                {entry.data.title}
                <span>{entry.data.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
