---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedGear } from '../../lib/content';

const gear = await getPublishedGear();
---

<BaseLayout
  title="Gear criteria for UK emergency kits"
  description="Comparison criteria for torches, power banks, wind-up radios, water storage, first-aid kits and winter car supplies, written for UK emergency planning."
  canonicalPath="/gear/"
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Gear</p>
      <h1>Gear criteria for a UK emergency kit</h1>
      <p class="lede">
        Criteria first. Product links appear only on our 72-hour kit guide, as labelled Amazon
        affiliate links.
      </p>
      <ul class="link-list">
        {
          gear.map((entry) => (
            <li>
              <a href={`/gear/${entry.id}/`}>
                {entry.data.title}
                <span>{entry.data.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
