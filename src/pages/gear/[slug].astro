---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import CompareLinks from '../../components/catalogue/CompareLinks.astro';
import EditorByline from '../../components/EditorByline.astro';
import { getPublishedGear } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const gear = await getPublishedGear();
  return gear.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const reviewed = (entry.data.lastReviewed ?? entry.data.updated ?? entry.data.pubDate).toLocaleDateString(
  'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric' },
);
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.seoDescription ?? entry.data.description}
  canonicalPath={`/gear/${entry.id}/`}
>
  <article class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Gear criteria</p>
      <h1>{entry.data.heading ?? entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <p class="meta">
        <EvidenceBadge kind="desk-research" />
        <EvidenceBadge kind="official-guidance" />
        <EditorByline reviewed={reviewed} />
      </p>

      <h2>What we compare</h2>
      <ul>
        {entry.data.criteria.map((item) => <li>{item}</li>)}
      </ul>

      <div class="prose">
        <Content />
      </div>

      <CompareLinks categories={[entry.data.category]} />

      {
        entry.data.sources.length > 0 && (
          <section class="sources-block">
            <h2>Sources</h2>
            <ul class="source-list">
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="reviewed-note">Last reviewed {reviewed}.</p>
          </section>
        )
      }

    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.25rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .sources-block {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .reviewed-note {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  @media print {
    .no-print,
    .product-card__buy,
    .ad-block {
      display: none !important;
    }
  }
</style>
