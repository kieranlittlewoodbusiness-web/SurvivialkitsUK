---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import CompareLinks from '../../components/catalogue/CompareLinks.astro';
import EditorByline from '../../components/EditorByline.astro';
import { getPublishedGear } from '../../lib/content';
import {
  article,
  breadcrumbList,
  crumbsForPage,
  isoDate,
  pageUrl,
  personNode,
  webPage,
} from '../../lib/seo/jsonld';
import { formatLondonDate, publishedIfDifferent } from '../../lib/dates';
import { reviewedDate } from '../../lib/content-dates';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const gear = await getPublishedGear();
  return gear.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const heading = entry.data.heading ?? entry.data.title;
const description = entry.data.seoDescription ?? entry.data.description;
const canonicalPath = `/gear/${entry.id}/`;
const url = pageUrl(canonicalPath);
const crumb = entry.data.crumb ?? entry.data.title;
const datePublished = isoDate(entry.data.pubDate);
// SEO-6e: dateModified is the byline's reviewed day; the content schema guarantees it is the latest date.
const reviewedOn = reviewedDate(entry.data);
const dateModified = isoDate(reviewedOn);
const jsonLd = [
  webPage({
    url,
    name: heading,
    description,
    breadcrumb: true,
    mainEntity: `${url}#article`,
  }),
  article({ url, headline: heading, description, datePublished, dateModified }),
  personNode(),
  breadcrumbList(url, crumbsForPage(canonicalPath, crumb, { label: 'Gear criteria', href: '/gear/' })),
];
const reviewed = formatLondonDate(reviewedOn);
const published = publishedIfDifferent(entry.data.pubDate, reviewedOn);
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Gear criteria</p>
      <h1>{heading}</h1>
      <p class="lede">{entry.data.description}</p>
      <p class="meta">
        <EvidenceBadge kind="desk-research" />
        <EvidenceBadge kind="official-guidance" />
        <EditorByline reviewed={reviewed} published={published} />
      </p>

      <h2>What we compare</h2>
      <ul>
        {entry.data.criteria.map((item) => <li>{item}</li>)}
      </ul>

      <div class="prose">
        <Content />
      </div>

      <CompareLinks categories={[entry.data.category]} />

      {
        entry.data.sources.length > 0 && (
          <section class="sources-block">
            <h2>Sources</h2>
            <ul class="source-list">
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="reviewed-note">Last reviewed {reviewed}.</p>
          </section>
        )
      }

    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.25rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .sources-block {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .reviewed-note {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  @media print {
    .no-print,
    .product-card__buy,
    .ad-block {
      display: none !important;
    }
  }
</style>
