---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { editor } from '../../data/editor';
import { breadcrumbList, crumbsForPage, pageUrl, webPage } from '../../lib/seo/jsonld';

const canonicalPath = editor.path;
const url = pageUrl(canonicalPath);
const jsonLd = [
  webPage({
    url,
    name: editor.name,
    description: editor.description,
    breadcrumb: true,
  }),
  breadcrumbList(url, crumbsForPage(canonicalPath, editor.name, { label: 'About', href: '/about/' })),
];
---

<BaseLayout
  title={editor.title}
  description={editor.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="wrap wrap--narrow">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About</a></li>
          <li aria-current="page">{editor.name}</li>
        </ol>
      </nav>

      <div class="prose">
        <h1>{editor.name}</h1>
        <p>Kieran Littlewood is the editor of UK Survival Kits.</p>

        <h2>What I do</h2>
        <p>I choose the products on this site and use them where I can before sharing them.</p>

        <h2>Why I started UK Survival Kits</h2>
        <p>I started it after global tensions were rising and I saw so many people being unprepared.</p>

        <h2>How the guides work</h2>
        <p>
          Safety advice on this site links to official UK sources such as gov.uk, the Met Office and
          the British Red Cross. You can read more in <a href="/method/">our method</a> and
          {' '}<a href="/editorial-policy/">editorial policy</a>.
        </p>

        <h2>Affiliate links and contact</h2>
        <p>
          Some links are Amazon affiliate links; see the
          {' '}<a href="/affiliate-disclosure/">affiliate disclosure</a>. To report a mistake or get
          in touch, use the <a href="/contact/">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    list-style: none;
    padding: 0 0 var(--s-4);
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink-2);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--s-2);
    color: var(--ink-3);
  }
</style>
