---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedScenarios } from '../../lib/content';

const scenarios = await getPublishedScenarios();
---

<BaseLayout
  title="UK emergency scenario guides"
  description="Household scenario guides for UK emergencies, including power cuts, Met Office weather warnings, flood alerts, water interruptions and temporary evacuation."
  canonicalPath="/scenarios/"
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Articles</p>
      <h1>Household emergency scenario guides</h1>
      <p class="lede">
        Each guide starts with inventory and official advice before any product criteria.
      </p>
      <ul class="link-list scenario-index">
        {
          scenarios.map((entry) => (
            <li>
              <a href={`/scenarios/${entry.id}/`}>
                {entry.data.title}
                <span>{entry.data.scenario}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .scenario-index {
    margin-top: 1.5rem;
  }
</style>
