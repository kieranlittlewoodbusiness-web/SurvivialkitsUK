---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import CompareLinks from '../../components/catalogue/CompareLinks.astro';
import EditorByline from '../../components/EditorByline.astro';
import { getPublishedScenarios } from '../../lib/content';
import {
  article,
  breadcrumbList,
  crumbsForPage,
  dateModifiedOf,
  isoDate,
  pageUrl,
  webPage,
} from '../../lib/seo/jsonld';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const scenarios = await getPublishedScenarios();
  return scenarios.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const heading = entry.data.heading ?? entry.data.title;
const description = entry.data.description;
const canonicalPath = `/scenarios/${entry.id}/`;
const url = pageUrl(canonicalPath);
const crumb = entry.data.crumb ?? entry.data.title;
const datePublished = isoDate(entry.data.pubDate);
const dateModified = dateModifiedOf(entry.data.updated, entry.data.lastReviewed, entry.data.pubDate);
const jsonLd = [
  webPage({
    url,
    name: heading,
    description,
    breadcrumb: true,
    mainEntity: `${url}#article`,
  }),
  article({ url, headline: heading, description, datePublished, dateModified }),
  breadcrumbList(url, crumbsForPage(canonicalPath, crumb, { label: 'Scenarios', href: '/scenarios/' })),
];

const reviewed = entry.data.lastReviewed.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Scenario</p>
      <h1>{heading}</h1>
      <p class="lede">{entry.data.scenario}</p>
      <p class="meta">
        {entry.data.evidence.map((kind) => <EvidenceBadge kind={kind} />)}
        <EditorByline reviewed={reviewed} />
      </p>

      <div class="prose">
        <Content />
      </div>

      {
        entry.data.sources.length > 0 && (
          <section class="sources-block">
            <h2>Sources</h2>
            <ul class="source-list">
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="reviewed-note">Last reviewed {reviewed}. Re-check campaign URLs before major updates.</p>
          </section>
        )
      }

      <CompareLinks categories={entry.data.gearCategories} />

    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    color: var(--ink-muted);
    font-size: 0.92rem;
    margin-bottom: 1.25rem;
  }

  .sources-block {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .reviewed-note {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }


  @media print {
    .no-print,
    .product-card__buy,
    .ad-block {
      display: none !important;
    }
  }
</style>
