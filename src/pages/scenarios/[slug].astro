---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import AdBlock from '../../components/AdBlock.astro';
import ReviewFlags from '../../components/ReviewFlags.astro';
import ProductComparison from '../../components/ProductComparison.astro';
import { getPublishedScenarios } from '../../lib/content';
import { getLiveOffers, getPendingOffers } from '../../lib/retailerOffers';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const scenarios = await getPublishedScenarios();
  return scenarios.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const offerCategories = entry.data.gearCategories;
const offers = offerCategories.flatMap((cat) => getLiveOffers(cat));
const pending = offerCategories.flatMap((cat) => getPendingOffers(cat));
const showAd = entry.data.affiliate && (offers.length > 0 || pending.length > 0);
const reviewed = entry.data.lastReviewed.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/scenarios/${entry.id}`}
  ogType="article"
  showAmazonNotice={offers.some((o) => o.network === 'amazon-associates')}
>
  <article class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Scenario</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.scenario}</p>
      <p class="meta">
        {entry.data.evidence.map((kind) => <EvidenceBadge kind={kind} />)}
        <span>Last reviewed {reviewed}</span>
      </p>

      <ReviewFlags flags={entry.data.reviewFlags} />

      <div class="prose">
        <Content />
      </div>

      {
        entry.data.sources.length > 0 && (
          <section class="sources-block">
            <h2>Sources</h2>
            <ul class="source-list">
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="reviewed-note">Last reviewed {reviewed}. Re-check campaign URLs before major updates.</p>
          </section>
        )
      }

      {
        entry.data.gearCategories.map((cat) => (
          <div class="compare-embed">
            <ProductComparison category={cat} heading={`Related comparisons · ${cat.replaceAll('-', ' ')}`} />
          </div>
        ))
      }

      {
        showAd && (
          <div class="no-print">
            <AdBlock
              offers={offers.length ? offers : []}
              heading="Related retailer examples"
              pendingNote="No live affiliate links on this article yet. Comparison cards above explain what to look for without a purchase prompt."
            />
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    color: var(--ink-muted);
    font-size: 0.92rem;
    margin-bottom: 1.25rem;
  }

  .sources-block {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .reviewed-note {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .compare-embed {
    margin-top: 1.5rem;
  }

  @media print {
    .no-print,
    .product-card__buy,
    .ad-block {
      display: none !important;
    }
  }
</style>
