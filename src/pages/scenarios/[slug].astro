---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import CompareLinks from '../../components/catalogue/CompareLinks.astro';
import { getPublishedScenarios } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const scenarios = await getPublishedScenarios();
  return scenarios.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const reviewed = entry.data.lastReviewed.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/scenarios/${entry.id}/`}
  ogType="article"
>
  <article class="section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Scenario</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.scenario}</p>
      <p class="meta">
        {entry.data.evidence.map((kind) => <EvidenceBadge kind={kind} />)}
        <span>Last reviewed {reviewed}</span>
      </p>

      <div class="prose">
        <Content />
      </div>

      {
        entry.data.sources.length > 0 && (
          <section class="sources-block">
            <h2>Sources</h2>
            <ul class="source-list">
              {entry.data.sources.map((source) => (
                <li>
                  <a href={source.url} rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
            <p class="reviewed-note">Last reviewed {reviewed}. Re-check campaign URLs before major updates.</p>
          </section>
        )
      }

      <CompareLinks categories={entry.data.gearCategories} />

    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    color: var(--ink-muted);
    font-size: 0.92rem;
    margin-bottom: 1.25rem;
  }

  .sources-block {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .reviewed-note {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }


  @media print {
    .no-print,
    .product-card__buy,
    .ad-block {
      display: none !important;
    }
  }
</style>
