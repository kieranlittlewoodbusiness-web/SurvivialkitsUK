---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { hasLiveAmazonOffers } from '../lib/retailerOffers';

const amazonLive = site.amazonAssociatesLive && hasLiveAmazonOffers();
---

<BaseLayout
  title="Affiliate disclosure"
  description="How U.K. Survival Kit Brief labels affiliate advertising and Amazon Associates links under UK CAP/ASA rules."
  canonicalPath="/affiliate-disclosure"
>
  <section class="section">
    <div class="wrap wrap--narrow prose">
      <p class="eyebrow">Disclosure</p>
      <h1>Affiliate disclosure</h1>
      <p>
        Some links on this site are affiliate links. If you click and buy, we may earn a commission
        at no extra cost to you. Under the UK CAP Code, marketing must be obviously identifiable.
        We label commercial blocks with a clear <strong>Ad</strong> marker before you engage with
        those links.
      </p>
      <p>
        Affiliate URLs are stored centrally and rendered exactly as generated by the retailer
        programme. Links use <code>rel=&quot;sponsored&quot;</code>.
      </p>
      <h2>Amazon Associates</h2>
      {
        amazonLive ? (
          <aside class="amazon-notice" role="note">
            <strong>Amazon Associates disclosure</strong>
            As an Amazon Associate we earn from qualifying purchases. Amazon and the Amazon logo are
            trademarks of Amazon.com, Inc. or its affiliates.
          </aside>
        ) : (
          <p>
            Amazon Associates tracking links are <strong>not live</strong> on this launch build. When
            they go live, a prominent Amazon Associates statement will appear on pages that include
            those links, and <code>amazonAssociatesLive</code> will be set in site configuration.
          </p>
        )
      }
      <h2>Independence</h2>
      <p>
        Editorial criteria are written before retailer examples. We do not accept payment for
        favourable reviews in launch content. See also the
        {' '}<a href="/editorial-policy">editorial policy</a>.
      </p>
      <p>
        ASA advice:
        {' '}
        <a href="https://www.asa.org.uk/advice-online/affiliate-marketing.html" rel="noopener noreferrer"
          >Online affiliate marketing</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
