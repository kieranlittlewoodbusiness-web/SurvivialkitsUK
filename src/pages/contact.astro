---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { standardPageNodes } from '../lib/seo/jsonld';
import { siteTracking } from '../lib/tracking/config';

const title = 'Contact and corrections';
const heading = 'Contact';
const description =
  'Contact UK Survival Kits about corrections, sources or editorial questions. We do not provide emergency advice by email—call 999 if you are in danger.';
const canonicalPath = '/contact/';
const tracking = siteTracking().enabled;
const jsonLd = standardPageNodes({
  canonicalPath,
  heading,
  description,
  crumb: 'Contact',
  type: 'ContactPage',
  about: true,
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="wrap wrap--narrow prose">
      <p class="eyebrow">Contact</p>
      <h1>{heading}</h1>
      <p class="lede">
        For corrections, source updates or editorial questions, email the editors. We do not provide
        emergency advice by email—call 999 if you are in danger.
      </p>
      <p>
        Email:
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
      <p>
        Please include page URLs for corrections. We aim to update factual errors promptly and note
        significant revisions on the page.
      </p>
      {
        tracking ? (
          <p>This site has no contact form backend.</p>
        ) : (
          <p>
            This static launch build has no contact form backend and no third-party tracking scripts.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
