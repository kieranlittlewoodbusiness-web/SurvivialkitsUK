{
  "name": "uk-survival-kit-brief",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && astro build && npm run -s check:dist",
    "astro": "astro",
    "test": "vitest run",
    "check:links": "node scripts/check-outbound-links.mjs dist",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:content": "node scripts/check-content.mjs dist",
    "check:slash": "node scripts/check-trailing-slash.mjs dist",
    "check:dist": "npm run -s check:links && npm run -s check:content && npm run -s check:slash",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
