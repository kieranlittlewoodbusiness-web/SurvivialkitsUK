/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()

# Keep Cloudflare Pages hosts out of search. Host-specific rules follow
# https://developers.cloudflare.com/pages/configuration/headers/
# The production alias uksurvivalkits.pages.dev is not a preview URL, so it does
# not receive Pages' default X-Robots-Tag: noindex (versioned preview aliases do).
# These patterns cannot match uksurvivalkits.uk or www.uksurvivalkits.uk.
https://uksurvivalkits.pages.dev/*
  X-Robots-Tag: noindex

https://:version.uksurvivalkits.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted build assets can be cached long-term.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
